# Copy to .env.local (git-ignored) and fill in what you have. All optional:
# without them the app uses rate-limited public endpoints.
# These values are compiled into the app and readable by anyone who has it:
# only use keys restricted to this app (allowed domains/app IDs, rate limits).

# Network a fresh install starts on: testnet (Sepolia + Solana Devnet) or mainnet.
EXPO_PUBLIC_DEFAULT_NETWORK=testnet

# Ethereum RPC, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
EXPO_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=
EXPO_PUBLIC_ETHEREUM_MAINNET_RPC_URL=

# Solana RPC, e.g. https://devnet.helius-rpc.com/?api-key=<key>
EXPO_PUBLIC_SOLANA_DEVNET_RPC_URL=
EXPO_PUBLIC_SOLANA_MAINNET_RPC_URL=

# CoinGecko Demo API key (free at coingecko.com/en/api), for higher price-data rate limits.
EXPO_PUBLIC_COINGECKO_API_KEY=
